# Copy to /etc/waf-sklookup/waf-sklookup.env and adjust absolute paths.
OPENRESTY_PREFIX=/usr/local/openresty
OPENRESTY_CONF=/opt/waf-sklookup-demo/openresty/nginx.conf
OPENRESTY_RUNTIME_PREFIX=/opt/waf-sklookup-demo/openresty
LOADER_BIN=/opt/waf-sklookup-demo/rust/loader/target/release/waf-sklookup-loader
PORTS_FILE=/opt/waf-sklookup-demo/ports.conf
PIN_DIR=/sys/fs/bpf/waf-sklookup
TARGET=127.0.0.1:8080
WAIT=60s
CTL_SOCK=/run/waf-sklookup/ctl.sock

# Stock OpenResty TLS fallback only. Leave empty for HAH/Tengine.
TLS_TARGET=127.0.0.1:8443
TLS_PORTS=18443
